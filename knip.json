{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["server.ts", "scripts/*.ts", ".storybook/vite.config.ts"]
    },
    "landing": {
      "entry": ["src/pages/**/*.{astro,js,ts}"],
      "project": ["**/*.{astro,js,mjs,ts,tsx}"],
      "ignoreBinaries": ["astro"]
    }
  },
  "ignoreDependencies": [
    "@fontsource/source-sans-pro",
    "@storybook/builder-vite",
    "@types/express-serve-static-core",
    "testcontainers"
  ]
}
