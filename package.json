{
  "name": "deployment-audit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "tsx scripts/migrate.ts && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "check": "pnpm run lint && pnpm run typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "node-pg-migrate up -m app/db/migrations",
    "db:migrate:down": "node-pg-migrate down -m app/db/migrations",
    "db:migrate:create": "node-pg-migrate create -m app/db/migrations",
    "db:init": "tsx scripts/init-db.ts",
    "test:nais-discovery": "tsx scripts/test-nais.ts discovery",
    "test:nais-fetch": "tsx scripts/test-nais.ts fetch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@google-cloud/storage": "^8.0.1",
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@react-pdf/renderer": "^4.6.1",
    "@react-router/express": "8.3.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@slack/bolt": "5.0.0",
    "@slack/types": "3.0.0",
    "@types/pg": "^8.23.1",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "exceljs": "npm:@protobi/exceljs@4.4.0-protobi.10",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "helmet": "^8.3.0",
    "isbot": "^5.2.1",
    "jose": "^6.2.9",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@react-router/dev": "8.3.0",
    "@storybook/react": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^20.11.6",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "storybook": "10.5.10",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
